{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "0.1.0",
  "identifier": "dev.voiceflow.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoiceFlow",
        "url": "index.html",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local push-to-talk dictation",
    "longDescription": "Hold a shortcut, speak, and release: VoiceFlow transcribes your speech on-device with Cactus Whistle and pastes the text into the focused application. No audio leaves your computer.",
    "publisher": "VoiceFlow contributors",
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ],
        "section": "utils",
        "files": {
          "/usr/share/applications/dev.voiceflow.app.desktop": "linux/dev.voiceflow.app.desktop"
        }
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell"
        ],
        "files": {
          "/usr/share/applications/dev.voiceflow.app.desktop": "linux/dev.voiceflow.app.desktop"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "licenses/needle-LICENSE.txt": "licenses/needle-LICENSE.txt",
      "licenses/whistle-LICENSE.txt": "licenses/whistle-LICENSE.txt"
    }
  }
}
